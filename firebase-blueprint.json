{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a user profile on the Nivaastha platform.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string" },
        "savedPropertyIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["id", "mobileNumber"]
    },
    "Property": {
      "title": "Property",
      "description": "Represents a property listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "rent": { "type": "number" },
        "salePrice": { "type": "number" },
        "isRented": { "type": "boolean" },
        "address": {
          "type": "object",
          "properties": {
            "street": { "type": "string" },
            "colony": { "type": "string" },
            "sector": { "type": "string" },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "pin": { "type": "string" },
            "country": { "type": "string" }
          }
        },
        "owner": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "mobile": { "type": "string" }
          }
        },
        "images": {
          "type": "object",
          "properties": {
            "frontView": { "$ref": "PropertyImage" },
            "kitchen": { "$ref": "PropertyImage" },
            "rooms": { "type": "array", "items": { "$ref": "PropertyImage" } },
            "hall": { "type": "array", "items": { "$ref": "PropertyImage" } }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "rent", "owner"]
    },
    "PropertyImage": {
      "title": "PropertyImage",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "hint": { "type": "string" }
      }
    },
    "OTP": {
      "title": "OTP",
      "description": "Stores temporary OTP data for verification.",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "otpHash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "attemptCount": { "type": "integer" }
      },
      "required": ["phoneNumber", "otpHash", "createdAt", "expiresAt", "attemptCount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles."
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Public property listings."
    },
    "/otps/{phoneNumber}": {
      "schema": "OTP",
      "description": "Temporary OTP storage. Restricted logic should typically be server-side."
    }
  }
}
