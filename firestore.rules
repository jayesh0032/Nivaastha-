rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Denial ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && incoming().id == userId;
      allow update: if isOwner(userId) && incoming().id == existing().id;
      allow delete: if isOwner(userId);
    }

    // --- Properties Collection ---
    match /properties/{propertyId} {
      function isPropertyOwner() {
        return isSignedIn() && (existing().owner.mobile == request.auth.token.phone_number || existing().owner.mobile == request.auth.token.email);
      }
      
      allow read, list: if true;
      allow create: if isSignedIn();
      allow update: if isPropertyOwner() && incoming().id == existing().id;
      allow delete: if isPropertyOwner();
    }

    // --- OTPs Collection (Server-side ONLY) ---
    // Since we use Firebase Admin SDK in API routes, we don't need any client-side access.
    match /otps/{phoneNumber} {
      allow read, write: if false;
    }
  }
}
